# PatentLens AI — Production Backend Environment Variables (Render / Cloud Deployment)
ENVIRONMENT=production
PORT=8000
FRONTEND_URL=https://your-patentlens-frontend.vercel.app

# Database Configurations
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
MONGODB_URL=mongodb+srv://user:password@cluster0.sample.mongodb.net/patentlens?retryWrites=true&w=majority
MONGODB_DB_NAME=patentlens

# JWT Security
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Machine Learning & LLM Provider Configuration
LLM_PROVIDER=groq
MODEL_NAME=all-MiniLM-L6-v2
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# External Patent APIs (The Lens / PatentsView / arXiv)
LENS_API_TOKEN=your_lens_api_token
LENS_API_URL=https://api.lens.org/patent/search
PATENTS_API_KEY=your_patents_api_key
PATENTS_API_PROVIDER=patentsview
MAX_EXTERNAL_API_RESULTS=100
